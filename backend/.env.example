# FlowState Backend — Environment Variables
# Copy this file to .env and fill in values for your environment.
# For local development with docker-compose, defaults work out of the box.

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Comma-separated list of Kafka broker addresses
KAFKA_BROKERS=localhost:9092

# Topic name (must match the topic created by kafka-init)
KAFKA_TOPIC=transaction-events

# Consumer group ID (used by consumer.ts only)
KAFKA_GROUP_ID=flowstate-fraud-detector

# ── Producer ──────────────────────────────────────────────────────────────────
# Milliseconds between each produced transaction (200 = 5 tx/sec)
PRODUCE_INTERVAL_MS=200

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── PostgreSQL ────────────────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=flowstate
PG_USER=flowstate_user
PG_PASSWORD=flowstate_pass

# ── Fraud Detection ───────────────────────────────────────────────────────────
# Risk scores above this value are flagged as fraud (0–100)
FRAUD_THRESHOLD=75

# Fixed window duration (seconds) for the Redis velocity counter
VELOCITY_WINDOW_SECONDS=60

# ── WebSocket ─────────────────────────────────────────────────────────────────
WS_PORT=8080
