{
  "name": "flowstate-backend",
  "version": "1.0.0",
  "description": "FlowState Real-Time Fraud Detection Pipeline — Backend",
  "private": true,
  "scripts": {
    "start:producer": "ts-node --transpile-only src/producer.ts",
    "start:consumer": "ts-node --transpile-only src/consumer.ts",
    "build": "tsc",
    "start:producer:compiled": "node dist/producer.js",
    "start:consumer:compiled": "node dist/consumer.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ioredis": "^5.3.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.11.3",
    "uuid": "^11.1.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
