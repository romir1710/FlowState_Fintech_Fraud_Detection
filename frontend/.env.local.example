# FlowState Frontend — Environment Variables
# Copy this file to .env.local for local development.
# NEXT_PUBLIC_* variables are embedded in the browser bundle at build time.

# WebSocket server URL.
# - Local dev: defaults to ws://localhost:8080 in code if this is unset.
# - Docker / production: set this to the actual WebSocket server address.
#   Example: NEXT_PUBLIC_WS_URL=ws://api.example.com:8080
#            NEXT_PUBLIC_WS_URL=wss://api.example.com/ws  (for TLS)
NEXT_PUBLIC_WS_URL=ws://localhost:8080
