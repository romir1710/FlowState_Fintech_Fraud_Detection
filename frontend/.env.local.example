# FlowState Frontend — Environment Variables
# Copy this file to .env.local for local development.
# VITE_* variables are embedded in the browser bundle at build time.

# WebSocket server URL.
# - Local dev: defaults to ws://localhost:8080 in code if this is unset.
# - Production (Vercel): set this to the Render consumer WebSocket URL.
#   Example: VITE_WS_URL=wss://flowstate-consumer.onrender.com
VITE_WS_URL=ws://localhost:8080
